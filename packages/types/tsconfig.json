{
  "extends": "@total-typescript/tsconfig/tsc/no-dom/library",
  "include": ["src/**/*.ts"],
  "compilerOptions": {
    "target": "esnext",
    "module": "nodenext",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true
  }
}
