{
  "centralServer": {
    "port": 8000,
    "changeEmail": {
      "enabled": true,
      "rateLimit": {
        "max": 1000,
        "timeWindow": 1000
      }
    },
    "createCharacter": {
      "enabled": true,
      "rateLimit": {
        "max": 1000,
        "timeWindow": 1000
      }
    },
    "login": {
      "enabled": true,
      "rateLimit": {
        "max": 1000,
        "timeWindow": 1000
      }
    },
    "purchaseSlot": {
      "enabled": true,
      "rateLimit": {
        "max": 1000,
        "timeWindow": 1000
      }
    },
    "renameCharacter": {
      "enabled": true,
      "rateLimit": {
        "max": 1000,
        "timeWindow": 1000
      }
    },
    "signup": {
      "enabled": true,
      "rateLimit": {
        "max": 1000,
        "timeWindow": 1000
      }
    },
    "status": {
      "rateLimit": {
        "max": 1000,
        "timeWindow": 1000
      }
    },
