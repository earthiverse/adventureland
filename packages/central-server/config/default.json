{
  "centralServer": {
    "port": 80,
    "login": {
      "enabled": true,
      "rateLimit": {
        "max": 5,
        "timeWindow": 60000
      }
    },
    "signup": {
      "enabled": true,
      "rateLimit": {
        "max": 2,
        "timeWindow": 60000
      }
    },
    "status": {
      "rateLimit": {
        "max": 2,
        "timeWindow": 60000
      }
    }
  },
  "database": {
    "uri": "mongodb://adventureland:adventureland@mongo:27017/adventureland",
    "name": "adventureland",
    "clientOptions": {
      "appName": "Adventureland Central Server",
      "directConnection": true
    }
  },
  "jwt": {
    "expiresIn": "30 days"
  }
}
