{
  "centralServer": {
    "port": 80,
    "createCharacter": {
      "enabled": true,
      "rateLimit": {
        "max": 5,
        "timeWindow": 60000
      },
      "minLength": 4,
      "maxLength": 12,
      "pattern": "[a-zA-Z]+[a-zA-Z0-9]*"
    },
    "login": {
      "enabled": true,
      "rateLimit": {
        "max": 5,
        "timeWindow": 60000
      }
    },
    "renameCharacter": {
      "enabled": true,
      "rateLimit": {
        "max": 5,
        "timeWindow": 60000
      },
      "minLength": 1,
      "maxLength": 12,
      "pattern": "[a-zA-Z]+[a-zA-Z0-9]*",
      "costs": {
        "1": 160000,
        "2": 48000,
        "3": 24000,
        "4": 2400,
        "5": 400,
        "6": 400,
        "7": 400,
        "8": 400,
        "9": 400,
        "10": 400,
        "11": 400,
        "12": 400
      }
    },
    "signup": {
      "enabled": true,
      "rateLimit": {
        "max": 2,
        "timeWindow": 60000
      }
    },
    "status": {
      "rateLimit": {
        "max": 2,
        "timeWindow": 60000
      }
    }
  },
  "database": {
    "uri": "mongodb://adventureland:adventureland@mongo:27017/adventureland",
    "name": "adventureland",
    "clientOptions": {
      "appName": "Adventureland Central Server",
      "directConnection": true
    }
  },
  "jwt": {
    "expiresIn": "30 days"
  }
}
