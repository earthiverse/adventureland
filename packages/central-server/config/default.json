{
  "centralServer": {
    "port": 80,
    "changeEmail": {
      "enabled": true,
      "rateLimit": {
        "max": 1,
        "timeWindow": 60000
      }
    },
    "createCharacter": {
      "enabled": true,
      "rateLimit": {
        "max": 5,
        "timeWindow": 60000
      },
      "minLength": 4,
      "maxLength": 12,
      "pattern": "[a-zA-Z]+[a-zA-Z0-9]*"
    },
    "login": {
      "enabled": true,
      "rateLimit": {
        "max": 5,
        "timeWindow": 60000
      }
    },
    "purchaseSlot": {
      "enabled": true,
      "rateLimit": {
        "max": 5,
        "timeWindow": 60000
      },
      "cost": 200,
      "maxSlots": 16
    },
    "renameCharacter": {
      "enabled": true,
      "rateLimit": {
        "max": 5,
        "timeWindow": 60000
      },
      "minLength": 1,
      "maxLength": 12,
      "pattern": "[a-zA-Z]+[a-zA-Z0-9]*",
      "costs": {
        "1": 160000,
        "2": 48000,
        "3": 24000,
        "4": 2400,
        "5": 400,
        "6": 400,
        "7": 400,
        "8": 400,
        "9": 400,
        "10": 400,
        "11": 400,
        "12": 400
      }
    },
    "signup": {
      "enabled": true,
      "rateLimit": {
        "max": 2,
        "timeWindow": 60000
      },
      "initial": {
        "shells": 0,
        "slots": 8
      }
    },
    "status": {
      "rateLimit": {
        "max": 2,
        "timeWindow": 60000
      }
    },
    "verifyEmail": {
      "enabled": true,
      "rateLimit": {
        "max": 1,
        "timeWindow": 60000
      },
      "codeLength": 32
    }
  },
  "database": {
    "uri": "mongodb://adventureland:adventureland@mongo:27017/adventureland",
    "name": "adventureland",
    "clientOptions": {
      "appName": "Adventureland Central Server",
      "directConnection": true
    }
  },
  "discord": {
    "uri": "https://discord.gg/44yUVeU"
  },
  "email": {
    "addressBook": {
      "help": "hello@adventure.land"
    }
  },
  "jwt": {
    "expiresIn": "30 days"
  },
  "logging": {
    "console": true
  }
}
