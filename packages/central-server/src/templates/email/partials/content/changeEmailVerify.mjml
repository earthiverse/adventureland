<mj-section>
  <mj-column>
    <mj-text font-size="36px" color="#333"
      >Hello, <span class="emphasis">{{characterName}}</span></mj-text
    >
    <mj-text color="#333"
      >Someone (hopefully you) requested that your account's email be changed to
      this one. Visiting the link below will change your account's email. If you
      did not request an email change, please contact
      <a href="mailto:{{helpEmail}}">{{helpEmail}}</a>!</mj-text
    >
    <mj-text font-family="m5x7"
      ><a href="{{verifyUrl}}">{{verifyUrl}}</a></mj-text
    >
  </mj-column>
</mj-section>
