{
  "centralServer": {
    "url": "http://central-server"
  },
  "gameServer": {
    "port": 80,
    "url": "http://game-server",
    "maxActiveCharacters": 3,
    "maxActiveMerchants": 1,
    "status": {
      "rateLimit": {
        "max": 2,
        "timeWindow": 60000
      }
    }
  },
  "database": {
    "uri": "mongodb://adventureland:adventureland@mongo:27017/adventureland",
    "name": "adventureland",
    "clientOptions": {
      "appName": "Adventureland Game Server",
      "directConnection": true
    }
  },
  "logging": {
    "console": true
  }
}
